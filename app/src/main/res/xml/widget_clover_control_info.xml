<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_clover_desc"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:maxResizeHeight="@dimen/clover_max_resize_height"
    android:maxResizeWidth="@dimen/clover_max_resize_width"
    android:minHeight="@dimen/clover_min_height"
    android:minResizeHeight="@dimen/clover_min_resize_height"
    android:minResizeWidth="@dimen/clover_min_resize_width"
    android:minWidth="@dimen/clover_min_width"
